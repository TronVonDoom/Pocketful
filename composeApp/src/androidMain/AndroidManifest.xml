<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Lets Settings hand a downloaded release to the package installer. On API 26+ this
        declaration only makes the "install unknown apps" toggle available to the user;
        the app still cannot install anything until they turn it on, which is what
        UpdateInstaller checks for before it downloads anything.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        enableOnBackInvokedCallback is declared rather than left to the target SDK's
        default. App() registers exactly one back handler, which unwinds sheets,
        selections and detail views before it ever falls through to the system, and on
        the tabs returns to Home rather than letting the app close. That handler reaches
        the gesture through OnBackPressedDispatcher, and this flag decides which of the
        platform's two dispatch routes it arrives by. Stating it means the answer is the
        same on every Android version instead of depending on the one running.
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pocketful">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Pocketful.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            How a downloaded APK reaches the installer. Handing out a file:// URI has been
            an exception since Android 7, so the file is served from the app's own cache
            through a content:// URI with a one-shot read grant attached to the intent.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
