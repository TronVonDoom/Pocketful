<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon on API 26 and up, as two layers the launcher animates and masks
    independently.

    Both layers are bitmaps cut by tools/icons/generate_icons.py from art/icon-source.png.
    The background carries the brand ground and the bloom behind the render, so the dark
    pocket keeps a silhouette on a dark home screen; the foreground is the render alone,
    sized to about two thirds of the visible tile rather than to the edge of the safe
    zone. The safe zone says what a mask will not cut, not how big the artwork should be,
    and a render that fills it leaves the plate behind it as a hairline.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
